  "contact": {
    "issues": "https://github.com/iGoodie/TwitchSpawn/issues"
  },
  "license": "EPL-1.0",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.programmer.igoodie.twitchspawn.TwitchSpawn"],
    "client": ["net.programmer.igoodie.twitchspawn.client.TwitchSpawnClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
